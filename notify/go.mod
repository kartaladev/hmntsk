module github.com/kartaladev/hmntsk/notify

go 1.26.0

// notify names no module of the task engine and never will: it is a generic
// notification library that moves to its own repository before its first tag.
// Its production code uses the standard library only.

require (
	github.com/stretchr/testify v1.12.1 // indirect
	go.uber.org/goleak v1.3.0 // indirect
	go.uber.org/mock v0.6.0 // indirect
)
