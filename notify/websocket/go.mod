module github.com/kartaladev/hmntsk/notify/websocket

go 1.26.0

// The dependency on github.com/kartaladev/hmntsk/notify is supplied by the
// repository's go.work during development and is written in here, with a real
// version, when notify is tagged in its own repository.

require (
	github.com/coder/websocket v1.8.15 // indirect
	github.com/stretchr/testify v1.12.1 // indirect
	go.uber.org/goleak v1.3.0 // indirect
)
